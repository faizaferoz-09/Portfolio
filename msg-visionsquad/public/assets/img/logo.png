<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 80" width="420" height="80">
  <defs>
    <linearGradient id="cyberNeonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00f3ff" />
      <stop offset="45%" stop-color="#8b2bf5" />
      <stop offset="100%" stop-color="#ff2a8d" />
    </linearGradient>
    <linearGradient id="bladeGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ff2a8d" />
      <stop offset="50%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#00f3ff" />
    </linearGradient>
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Emblem Icon on Left -->
  <g transform="translate(10, 8)">
    <!-- Hexagonal Cyber Gateway -->
    <polygon points="32,4 60,20 60,52 32,68 4,52 4,20" fill="url(#cyberNeonGrad)" opacity="0.18" stroke="url(#cyberNeonGrad)" stroke-width="2.5"/>
    
    <!-- Outer Orbital Ring -->
    <circle cx="32" cy="36" r="22" fill="none" stroke="#00f3ff" stroke-width="2" stroke-dasharray="8,4" filter="url(#neonGlow)"/>
    
    <!-- Inner Portal Core -->
    <circle cx="32" cy="36" r="14" fill="#141f48" stroke="#ff2a8d" stroke-width="1.8"/>
    
    <!-- Stylized Katana Slash / Energy Shard -->
    <path d="M 12 56 L 52 16" stroke="url(#bladeGrad)" stroke-width="4" stroke-linecap="round" filter="url(#neonGlow)"/>
    <polygon points="54,14 44,18 48,28" fill="#00f3ff"/>

    <!-- Controller D-Pad Core Spark -->
    <circle cx="32" cy="36" r="4" fill="#ffffff" filter="url(#neonGlow)"/>
  </g>

  <!-- Typography -->
  <text x="88" y="47" font-family="'Orbitron', sans-serif" font-size="34" font-weight="900" fill="#ffffff" letter-spacing="2">FANDOM<tspan fill="url(#cyberNeonGrad)" filter="url(#neonGlow)">VERSE</tspan></text>
  
  <text x="92" y="65" font-family="'Outfit', sans-serif" font-size="10.5" font-weight="700" fill="#00f3ff" letter-spacing="5" opacity="0.95">PORTAL FOR FANDOM WORLD</text>
</svg>